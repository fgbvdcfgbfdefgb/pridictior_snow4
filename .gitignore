# training output ----------------------------------------------------------
# Your own runs stay local; the two reference runs shipped with the repo are
# whitelisted so the committed metrics / checkpoints / prediction tape survive.
runs/*
!runs/.gitkeep
!runs/demo/
!runs/replay_holdout/
*.log

# scratch -------------------------------------------------------------------
build/
work/
tmp/
.ipynb_checkpoints/
.DS_Store

# python --------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# never commit credentials --------------------------------------------------
.env
*.token
secrets.json
.snowflake/
